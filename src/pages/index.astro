---
import Layout from "../layouts/Layout.astro"
import { Header } from "../components/header"
import "../styles/global.css"
---

<Layout>
  <div class="min-h-screen bg-background">
    <Header client:load />
    <div class="h-[calc(100svh-var(--spacing)*14-1px)]">
      <main
        class="container mx-auto flex gap-4 h-[80%] flex-1 flex-col items-center justify-center px-4"
      >
        <h1
          class="text-center font-bold leading-tight tracking-tighter text-4xl md:text-5xl lg:text-6xl"
        >
          Astro Docs Sample
        </h1>

        <p class="text-center text-muted-foreground">
          Search through the documentation by the search bar above.
        </p>
      </main>
    </div>
  </div>
</Layout>
